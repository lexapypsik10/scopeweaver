{
  "schema_version": "1.0",
  "scope": {
    "domains": [
      "lab.example",
      "*.lab.example"
    ],
    "networks": [
      "192.0.2.0/28"
    ],
    "ports": [
      22,
      80,
      443,
      8000
    ],
    "dns": {
      "servers": [
        "192.0.2.53"
      ],
      "port": 53
    },
    "whois": {
      "lab.example": {
        "ip": "192.0.2.43",
        "port": 43
      }
    }
  },
  "limits": {
    "concurrency": 4,
    "requests_per_second": 2.0,
    "max_operations": 200,
    "timeout": 4.0,
    "max_response_bytes": 131072,
    "max_targets": 32
  },
  "scan_ports": [
    22,
    80,
    443
  ],
  "dns_types": [
    "A",
    "AAAA",
    "MX",
    "NS",
    "TXT",
    "SOA"
  ],
  "subdomains": [
    "www"
  ],
  "whois_enabled": true,
  "tls_legacy_probes": false,
  "ca_file": null,
  "audit_log": "scopeweaver-audit.jsonl",
  "stop_file": null,
  "enabled_plugins": []
}
