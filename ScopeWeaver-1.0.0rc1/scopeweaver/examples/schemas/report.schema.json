{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool": {
          "default": "ScopeWeaver",
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "default": "1.0.0rc1",
          "title": "Version",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "scope": {
          "additionalProperties": true,
          "title": "Scope",
          "type": "object"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ModuleResult"
          },
          "title": "Results",
          "type": "array"
        },
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "network_operations": {
          "default": 0,
          "title": "Network Operations",
          "type": "integer"
        }
      },
      "title": "Assessment",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "remediation": {
          "title": "Remediation",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "cwe": {
          "items": {
            "type": "string"
          },
          "title": "Cwe",
          "type": "array"
        },
        "cvss": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss"
        },
        "cvss_vector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss Vector"
        },
        "confidence": {
          "default": "observed configuration; impact needs contextual review",
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "module",
        "target",
        "title",
        "severity",
        "description",
        "evidence",
        "remediation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ModuleResult": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "title": "Module",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "status": {
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "title": "Services",
          "type": "array"
        },
        "observations": {
          "additionalProperties": true,
          "title": "Observations",
          "type": "object"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "module",
        "target"
      ],
      "title": "ModuleResult",
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "default": "tcp",
          "title": "Transport",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "name": {
          "default": "unknown",
          "title": "Name",
          "type": "string"
        },
        "detection": {
          "default": "not identified",
          "title": "Detection",
          "type": "string"
        },
        "banner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Banner"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "host",
        "ip",
        "port",
        "state"
      ],
      "title": "Service",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "Info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment": {
      "$ref": "#/$defs/Assessment"
    },
    "summary": {
      "additionalProperties": true,
      "title": "Summary",
      "type": "object"
    }
  },
  "required": [
    "assessment",
    "summary"
  ],
  "title": "ReportDocument",
  "type": "object"
}
