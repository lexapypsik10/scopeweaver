{
  "$defs": {
    "PasswordPolicy": {
      "additionalProperties": false,
      "properties": {
        "minimum_length": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Length"
        },
        "maximum_length": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Length"
        },
        "mfa_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mfa Required"
        },
        "blocklist_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocklist Enabled"
        },
        "rate_limit_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Limit Enabled"
        },
        "composition_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composition Required"
        },
        "periodic_rotation_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Periodic Rotation Required"
        },
        "reversible_encryption": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reversible Encryption"
        },
        "lockout_threshold": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lockout Threshold"
        }
      },
      "title": "PasswordPolicy",
      "type": "object"
    },
    "Sample": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "value": {
          "format": "password",
          "maxLength": 1024,
          "minLength": 1,
          "title": "Value",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "id",
        "value"
      ],
      "title": "Sample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "policy": {
      "$ref": "#/$defs/PasswordPolicy"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/Sample"
      },
      "maxItems": 10000,
      "title": "Samples",
      "type": "array"
    },
    "context_words": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Context Words",
      "type": "array"
    }
  },
  "required": [
    "synthetic",
    "policy"
  ],
  "title": "PasswordDataset",
  "type": "object"
}
